# Finance API config for harness/finance/post_usage.py.
#
# Copy to .env and fill in. .env is gitignored; .env.example is not.
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   ./.venv/bin/python harness/finance/post_usage.py output/<task>/<model>/run_1
#
# NOTE: nothing in this repo loads .env automatically -- post_usage.py reads
# plain shell environment variables via os.environ. `set -a` is what exports
# every assignment in the file so the sourced values actually reach it. Without
# `set -a` they stay shell-local and post_usage sees nothing.
#
# A real shell variable set outside this file wins, since sourcing only assigns
# what is listed here.
#
# ---------------------------------------------------------------------------
# These names are DEKU_-prefixed and do NOT match the FINANCE_* names used by
# the sibling harness's harness.py + .env. Same API, same values, different
# variable names. Copying that file verbatim leaves every var unread and
# post_usage silently stays in dry-run. The mapping is:
#     FINANCE_API_URL        -> DEKU_FINANCE_URL
#     FINANCE_API_TOKEN      -> DEKU_FINANCE_TOKEN
#     FINANCE_PROJECT_ID     -> DEKU_PROJECT_ID
#     FINANCE_PROJECT_TYPE   -> DEKU_PROJECT_TYPE
#     FINANCE_TEAM_TYPE      -> DEKU_TEAM_TYPE
#     FINANCE_BUDGET_TYPE    -> DEKU_BUDGET_TYPE
#     FINANCE_RFP_SUB_TYPE   -> DEKU_RFP_SUB_TYPE
#     FINANCE_PRODUCTION_MODE-> DEKU_PRODUCTION_MODE
#     FINANCE_SUBSCRIPTION_ID-> DEKU_SUBSCRIPTION_ID
# ---------------------------------------------------------------------------

# --- Anthropic bridge ------------------------------------------------------
# BOTH names, same value. ANTHROPIC_BASE_URL is read by the claude-code agent
# and the graders; ANTHROPIC_API_BASE by openhands (litellm), the default
# agent. Setting only one sends the other straight to api.anthropic.com with
# the bridge secret as an API key -> 401 minutes into a paid run.
# ANTHROPIC_API_KEY is intentionally NOT here: it is `cat .bridge_secret`,
# regenerated whenever the bridge restarts, so export it in your shell.
ANTHROPIC_BASE_URL=http://host.docker.internal:8765
ANTHROPIC_API_BASE=http://host.docker.internal:8765

# --- Headroom grader compression -------------------------------------------
# The single on/off switch. Each task.toml carries
#   DEKU_GRADER_HEADROOM_ENABLED = "${DEKU_GRADER_HEADROOM_ENABLED:-false}"
# in [verifier].env, so this value is interpolated straight into the grader
# container -- flip it here and the next run picks it up. No per-task edit, no
# image rebuild.
#
# Compresses GRADER prompts only. Never wire it into the agent path: 98.5% of
# agent prompt tokens are cache reads, and compressing a cached prefix costs
# several times more than it saves. See harness/eval/HEADROOM.md.
DEKU_GRADER_HEADROOM_ENABLED=false

# --- Autopost --------------------------------------------------------------
# When true, bin/deku-run reports the run to finance as a [4/4] phase instead of
# you running post_usage.py --post by hand.
#
# Posting is outward-facing and bills against DEKU_PROJECT_ID, so it is off
# unless this is set. It runs AFTER the score table and cannot fail the trial;
# post_usage.py keys receipts by trajectory_id, so a re-run cannot double-bill.
DEKU_FINANCE_AUTOPOST=true

# --- Finance API endpoint --------------------------------------------------
# Base URL only; post_usage.py appends /ethara_project/trajectory_usage/create
DEKU_FINANCE_URL=https://projects-stage.ethara.ai/api/v1

# Staging accepts unauthenticated POSTs, so this can stay unset there.
# Sent as `Authorization: Bearer <token>`; DEKU_FINANCE_AUTH switches the scheme.
# DEKU_FINANCE_TOKEN=
# DEKU_FINANCE_AUTH=bearer

# --- Billing classification ------------------------------------------------
# Static per project, so they live here rather than being retyped every run.
#
# DEKU_PROJECT_ID is YOUR project. Do not copy another team's value from their
# config -- the dashboard groups by this field, so a wrong value bills your runs
# to their project. Ask whoever owns the finance service which id is yours.
DEKU_PROJECT_ID=deku
DEKU_PROJECT_TYPE=Technical
DEKU_TEAM_TYPE=Projects

# RFP | Production
DEKU_BUDGET_TYPE=RFP

# Exactly one of the next two, matching DEKU_BUDGET_TYPE:
#   RFP        -> DEKU_RFP_SUB_TYPE    = Testing | Sampling   (production_mode empty)
#   Production -> DEKU_PRODUCTION_MODE = Singlephase | Multiphase (rfp_sub_type empty)
DEKU_RFP_SUB_TYPE=Testing
# DEKU_PRODUCTION_MODE=

# Billing subscription id. Left unset, the run's Anthropic account_uuid is sent
# instead -- set this only if finance needs its own SUB-… identifier.
# DEKU_SUBSCRIPTION_ID=
