    {"name": "list files as guest (file security)", "request": {"method": "GET", "url": "{{baseUrl}}/v1/storage/buckets/app_uploads/files",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}]}},
    {"name": "list files as session user", "request": {"method": "GET", "url": "{{baseUrl}}/v1/storage/buckets/app_uploads/files",
