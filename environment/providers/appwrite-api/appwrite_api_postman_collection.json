    {"name": "list users", "request": {"method": "GET", "url": "{{baseUrl}}/v1/users?queries[]=equal(\"status\", [true])&queries[]=orderAsc(\"name\")&queries[]=limit(5)",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Key", "value": "standard_9f3c1a7e5b2d4086af51c7e93b0d6248"}]}},
    {"name": "get user", "request": {"method": "GET", "url": "{{baseUrl}}/v1/users/usr_marcus_feld",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Key", "value": "standard_9f3c1a7e5b2d4086af51c7e93b0d6248"}]}},
    {"name": "get account", "request": {"method": "GET", "url": "{{baseUrl}}/v1/account",
