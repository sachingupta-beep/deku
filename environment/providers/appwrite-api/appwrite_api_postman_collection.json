{
  "info": {
    "name": "Appwrite Mock API 1.6",
    "description": "Test collection for the mock self-hosted Appwrite service. Base URL defaults to http://localhost:8104. In docker-compose, the service is reachable at http://appwrite-api:8104. X-Appwrite-Project is orbit-app; X-Appwrite-Key (standard_9f3c1a7e5b2d4086af51c7e93b0d6248) is a server key that bypasses permissions; X-Appwrite-Session (session_orbit_priya_9f3c1a7e) authenticates as usr_priya_raman; no header at all is a guest that sees only read(\"any\") rows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8104"}
  ],
  "item": [
    {"name": "health", "request": {"method": "GET", "url": "{{baseUrl}}/health"}},
    {"name": "api health", "request": {"method": "GET", "url": "{{baseUrl}}/v1/health"}},
    {"name": "health db", "request": {"method": "GET", "url": "{{baseUrl}}/v1/health/db"}},
    {"name": "health storage", "request": {"method": "GET", "url": "{{baseUrl}}/v1/health/storage"}},
    {"name": "get locale", "request": {"method": "GET", "url": "{{baseUrl}}/v1/locale"}},
    {"name": "get project", "request": {"method": "GET", "url": "{{baseUrl}}/v1/project",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}]}},
    {"name": "wrong project (404 expected)", "request": {"method": "GET", "url": "{{baseUrl}}/v1/locale",
      "header": [{"key": "X-Appwrite-Project", "value": "not-a-project"}]}},
    {"name": "list databases", "request": {"method": "GET", "url": "{{baseUrl}}/v1/databases",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Key", "value": "standard_9f3c1a7e5b2d4086af51c7e93b0d6248"}]}},
    {"name": "list databases without key (401 expected)", "request": {"method": "GET", "url": "{{baseUrl}}/v1/databases",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}]}},
    {"name": "get database", "request": {"method": "GET", "url": "{{baseUrl}}/v1/databases/orbit_app",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Key", "value": "standard_9f3c1a7e5b2d4086af51c7e93b0d6248"}]}},
    {"name": "list collections", "request": {"method": "GET", "url": "{{baseUrl}}/v1/databases/orbit_app/collections",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Key", "value": "standard_9f3c1a7e5b2d4086af51c7e93b0d6248"}]}},
    {"name": "get collection", "request": {"method": "GET", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/feedback",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Key", "value": "standard_9f3c1a7e5b2d4086af51c7e93b0d6248"}]}},
    {"name": "unknown collection (404 expected)", "request": {"method": "GET", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/invoices",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Key", "value": "standard_9f3c1a7e5b2d4086af51c7e93b0d6248"}]}},
    {"name": "list feedback as guest (document security)", "request": {"method": "GET", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/feedback/documents",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}]}},
    {"name": "list feedback as session user", "request": {"method": "GET", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/feedback/documents",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Session", "value": "session_orbit_priya_9f3c1a7e"}]}},
    {"name": "list feedback as server key", "request": {"method": "GET", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/feedback/documents?queries[]=orderDesc(\"rating\")&queries[]=limit(10)",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Key", "value": "standard_9f3c1a7e5b2d4086af51c7e93b0d6248"}]}},
    {"name": "query feedback (equal + lessThan)", "request": {"method": "GET", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/feedback/documents?queries[]=equal(\"platform\", [\"ios\"])&queries[]=lessThan(\"rating\", 4)&queries[]=select([\"message\",\"rating\",\"platform\"])",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Key", "value": "standard_9f3c1a7e5b2d4086af51c7e93b0d6248"}]}},
    {"name": "search feedback", "request": {"method": "GET", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/feedback/documents?queries[]=search(\"message\", \"dark mode\")",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Key", "value": "standard_9f3c1a7e5b2d4086af51c7e93b0d6248"}]}},
    {"name": "list feature flags as guest (public collection)", "request": {"method": "GET", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/feature_flags/documents?queries[]=equal(\"enabled\", [true])&queries[]=orderAsc(\"key\")",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}]}},
    {"name": "flags containing ios", "request": {"method": "GET", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/feature_flags/documents?queries[]=contains(\"platforms\", [\"ios\"])&queries[]=select([\"key\",\"platforms\",\"rolloutPercent\"])",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}]}},
    {"name": "list releases as guest (401 expected)", "request": {"method": "GET", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/releases/documents",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}]}},
    {"name": "list releases as session user", "request": {"method": "GET", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/releases/documents?queries[]=equal(\"channel\", [\"production\"])&queries[]=orderDesc(\"buildNumber\")",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Session", "value": "session_orbit_priya_9f3c1a7e"}]}},
    {"name": "releases pending release (isNull)", "request": {"method": "GET", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/releases/documents?queries[]=isNull(\"releasedAt\")",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Session", "value": "session_orbit_priya_9f3c1a7e"}]}},
    {"name": "get document", "request": {"method": "GET", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/feedback/documents/fb_aurora_001",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Key", "value": "standard_9f3c1a7e5b2d4086af51c7e93b0d6248"}]}},
    {"name": "get document as guest (404 expected - not permitted)", "request": {"method": "GET", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/feedback/documents/fb_aurora_001",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}]}},
    {"name": "create feedback document", "request": {"method": "POST", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/feedback/documents",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Session", "value": "session_orbit_priya_9f3c1a7e"}],
      "body": {"mode": "raw", "raw": "{\"documentId\": \"unique()\", \"data\": {\"rating\": 4, \"message\": \"Passkey sign-in in the beta build works well on iOS.\", \"platform\": \"ios\", \"appVersion\": \"4.9.0-beta.2\", \"status\": \"open\", \"userId\": \"usr_priya_raman\"}, \"permissions\": [\"read(\\\"user:usr_priya_raman\\\")\", \"read(\\\"team:team_aurora\\\")\"]}"}}},
    {"name": "create document missing attribute (400 expected)", "request": {"method": "POST", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/feedback/documents",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Session", "value": "session_orbit_priya_9f3c1a7e"}],
      "body": {"mode": "raw", "raw": "{\"documentId\": \"unique()\", \"data\": {\"rating\": 3, \"platform\": \"ios\"}}"}}},
    {"name": "create document unknown attribute (400 expected)", "request": {"method": "POST", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/feedback/documents",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Key", "value": "standard_9f3c1a7e5b2d4086af51c7e93b0d6248"}],
      "body": {"mode": "raw", "raw": "{\"documentId\": \"unique()\", \"data\": {\"rating\": 3, \"message\": \"x\", \"platform\": \"ios\", \"appVersion\": \"4.8.1\", \"status\": \"open\", \"userId\": \"usr_priya_raman\", \"sentiment\": \"neutral\"}}"}}},
    {"name": "create document as guest (401 expected)", "request": {"method": "POST", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/feedback/documents",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Appwrite-Project", "value": "orbit-app"}],
      "body": {"mode": "raw", "raw": "{\"documentId\": \"unique()\", \"data\": {\"rating\": 1, \"message\": \"anonymous\", \"platform\": \"web\", \"appVersion\": \"4.8.1\", \"status\": \"open\", \"userId\": \"anon\"}}"}}},
    {"name": "update document", "request": {"method": "PATCH", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/feedback/documents/fb_lumen_003",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Key", "value": "standard_9f3c1a7e5b2d4086af51c7e93b0d6248"}],
      "body": {"mode": "raw", "raw": "{\"data\": {\"status\": \"triaged\"}}"}}},
    {"name": "delete document", "request": {"method": "DELETE", "url": "{{baseUrl}}/v1/databases/orbit_app/collections/feedback/documents/fb_pelagic_006",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Key", "value": "standard_9f3c1a7e5b2d4086af51c7e93b0d6248"}]}},
    {"name": "list buckets", "request": {"method": "GET", "url": "{{baseUrl}}/v1/storage/buckets",
      "header": [{"key": "X-Appwrite-Project", "value": "orbit-app"}, {"key": "X-Appwrite-Key", "value": "standard_9f3c1a7e5b2d4086af51c7e93b0d6248"}]}},
    {"name": "get bucket", "request": {"method": "GET", "url": "{{baseUrl}}/v1/storage/buckets/app_uploads",
