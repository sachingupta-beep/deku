  "components": {
    "schemas": {
      "ExplainBody": {
        "properties": {
          "sql": {
            "type": "string",
            "title": "Sql"
          },
          "analyze": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analyze",
            "default": false
          },
          "verbose": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verbose",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "sql"
        ],
        "title": "ExplainBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "StatementBody": {
        "properties": {
          "sql": {
            "type": "string",
            "title": "Sql"
          },
          "params": {
            "anyOf": [
              {
                "items": {},
                "type": "array"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Params"
          },
          "max_rows": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Rows",
            "default": 1000
          },
          "as_of_system_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of System Time"
          }
        },
        "type": "object",
        "required": [
          "sql"
        ],
        "title": "StatementBody"
      },
      "TransactionBody": {
        "properties": {
          "statements": {
            "items": {
              "$ref": "#/components/schemas/TransactionStatement"
            },
            "type": "array",
            "title": "Statements"
          },
          "priority": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Priority",
            "default": "NORMAL"
          },
          "max_retries": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Retries",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "statements"
        ],
        "title": "TransactionBody"
      },
      "TransactionStatement": {
        "properties": {
          "sql": {
            "type": "string",
            "title": "Sql"
          },
          "params": {
            "anyOf": [
              {
                "items": {},
                "type": "array"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Params"
          }
        },
        "type": "object",
        "required": [
          "sql"
        ],
        "title": "TransactionStatement"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
