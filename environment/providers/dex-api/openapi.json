{
  "openapi": "3.1.0",
  "info": {
    "title": "Dex API (Mock)",
    "version": "v2.41.1",
    "description": "Mock of Dex, an OIDC federator with no user database of its own. Real identities live behind connectors; the only local store is the local connectors static passwords, so /api/v2/refresh and /api/v2/offline-sessions are the closest thing to a user list. Connectors decide what is possible (the password grant works via local and ldap, is refused by github); the device authorization grant (RFC 8628) is first-class; and a client may borrow another clients audience only if listed on its trustedPeers. The gRPC API under /api/v2 keeps Dexs success-with-flag envelopes: already_exists and not_found instead of 409 and 404."
  },
  "paths": {
    "/audit/requests": {
      "get": {
        "summary": "Get Audit Requests",
        "description": "Return captured request/response logs.\n\nWARNING: the unpaginated default response embeds a full copy of every\nresponse body seen this session and grows without bound \u2014 late in a\nsession it can exceed what client tooling returns intact (long output\nis often silently capped). Prefer `/audit/summary` for an overview, or\npage through with `limit`/`offset` and `include_body=false` (drops the\nbulky `response_body` field; `request_body` is always kept).\n\nDefaults (no params = full dump, bodies included) are kept for\ncompatibility with the grading harness, which reads this endpoint\nparameter-less and asserts on response_body content.",
        "operationId": "get_audit_requests_audit_requests_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "include_body",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Include Body"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
