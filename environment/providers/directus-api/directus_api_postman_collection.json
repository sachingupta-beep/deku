{
  "info": {
    "name": "Directus Mock API 11",
    "description": "Test collection for the mock self-hosted Directus service. Base URL defaults to http://localhost:8105. In docker-compose, the service is reachable at http://directus-api:8105. Static tokens select the role: dr_static_admin_4f81c6a930b7e254 is the Administrator (bypasses the permission table), dr_static_editor_2b90d7fc1e6a4830 is the Editor, and no token resolves to the Public role. Directus accepts the token as an Authorization Bearer header or as an access_token query parameter.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8105"}
  ],
  "item": [
    {"name": "health", "request": {"method": "GET", "url": "{{baseUrl}}/health"}},
    {"name": "server ping", "request": {"method": "GET", "url": "{{baseUrl}}/server/ping"}},
    {"name": "server health", "request": {"method": "GET", "url": "{{baseUrl}}/server/health"}},
    {"name": "server info", "request": {"method": "GET", "url": "{{baseUrl}}/server/info"}},
    {"name": "login", "request": {"method": "POST", "url": "{{baseUrl}}/auth/login",
      "header": [{"key": "Content-Type", "value": "application/json"}],
      "body": {"mode": "raw", "raw": "{\"email\": \"noor.aziz@orbit-labs.com\", \"password\": \"OrbitContent2026!\"}"}}},
    {"name": "login with bad password (401 expected)", "request": {"method": "POST", "url": "{{baseUrl}}/auth/login",
      "header": [{"key": "Content-Type", "value": "application/json"}],
      "body": {"mode": "raw", "raw": "{\"email\": \"noor.aziz@orbit-labs.com\", \"password\": \"wrong\"}"}}},
    {"name": "list posts as public (permission filter)", "request": {"method": "GET", "url": "{{baseUrl}}/items/posts?fields=id,status,title&sort=-publish_date"}},
    {"name": "list posts as editor (all statuses)", "request": {"method": "GET", "url": "{{baseUrl}}/items/posts?fields=id,status,title&sort=id",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_editor_2b90d7fc1e6a4830"}]}},
    {"name": "list posts with meta", "request": {"method": "GET", "url": "{{baseUrl}}/items/posts?meta=*&limit=3&fields=id,title",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "filter posts (_gt + _in)", "request": {"method": "GET", "url": "{{baseUrl}}/items/posts?filter={\"hits\":{\"_gt\":3000},\"category\":{\"_in\":[1,4]}}&fields=id,title,hits,category",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "filter posts (_or)", "request": {"method": "GET", "url": "{{baseUrl}}/items/posts?filter={\"_or\":[{\"status\":{\"_eq\":\"draft\"}},{\"hits\":{\"_gte\":8000}}]}&fields=id,status,title,hits&sort=id",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "filter posts by related category", "request": {"method": "GET", "url": "{{baseUrl}}/items/posts?filter={\"category\":{\"slug\":{\"_eq\":\"security\"}}}&fields=id,title,category.name",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "posts with relational fields", "request": {"method": "GET", "url": "{{baseUrl}}/items/posts?filter={\"id\":{\"_eq\":11}}&fields=id,title,category.name,category.color,author.first_name,author.last_name,image.filename_download",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "search posts", "request": {"method": "GET", "url": "{{baseUrl}}/items/posts?search=passkey&fields=id,status,title",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "posts contains tag", "request": {"method": "GET", "url": "{{baseUrl}}/items/posts?filter={\"tags\":{\"_contains\":\"auth\"}}&fields=id,title,tags",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "aggregate posts by status", "request": {"method": "GET", "url": "{{baseUrl}}/items/posts?aggregate={\"count\":\"*\",\"sum\":\"hits\"}&groupBy=status",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "get post", "request": {"method": "GET", "url": "{{baseUrl}}/items/posts/13?fields=*.*",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "get draft post as public (403 expected)", "request": {"method": "GET", "url": "{{baseUrl}}/items/posts/14"}},
    {"name": "get missing post (403 expected)", "request": {"method": "GET", "url": "{{baseUrl}}/items/posts/999",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "unknown collection (403 expected)", "request": {"method": "GET", "url": "{{baseUrl}}/items/invoices",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "list categories as public", "request": {"method": "GET", "url": "{{baseUrl}}/items/categories?sort=sort"}},
    {"name": "list job openings as public (open only)", "request": {"method": "GET", "url": "{{baseUrl}}/items/job_openings?fields=id,status,title,department"}},
    {"name": "list job openings as editor", "request": {"method": "GET", "url": "{{baseUrl}}/items/job_openings?fields=id,status,title&sort=id",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_editor_2b90d7fc1e6a4830"}]}},
    {"name": "create post as editor", "request": {"method": "POST", "url": "{{baseUrl}}/items/posts",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer dr_static_editor_2b90d7fc1e6a4830"}],
      "body": {"mode": "raw", "raw": "{\"status\": \"draft\", \"title\": \"Rolling out passkeys to the web app\", \"slug\": \"rolling-out-passkeys-web\", \"summary\": \"WebAuthn lands in the browser next.\", \"category\": 2, \"author\": \"5c07e83b-1f42-4d69-b3a8-07e5d91c264f\", \"reading_minutes\": 6, \"tags\": [\"auth\", \"roadmap\"]}"}}},
    {"name": "create post as public (403 expected)", "request": {"method": "POST", "url": "{{baseUrl}}/items/posts",
      "header": [{"key": "Content-Type", "value": "application/json"}],
      "body": {"mode": "raw", "raw": "{\"status\": \"draft\", \"title\": \"Anonymous post\", \"slug\": \"anonymous-post\"}"}}},
    {"name": "create post missing required field (400 expected)", "request": {"method": "POST", "url": "{{baseUrl}}/items/posts",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer dr_static_editor_2b90d7fc1e6a4830"}],
      "body": {"mode": "raw", "raw": "{\"status\": \"draft\", \"title\": \"No slug here\"}"}}},
    {"name": "update post as editor", "request": {"method": "PATCH", "url": "{{baseUrl}}/items/posts/15",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer dr_static_editor_2b90d7fc1e6a4830"}],
      "body": {"mode": "raw", "raw": "{\"status\": \"published\", \"publish_date\": \"2026-05-27\"}"}}},
    {"name": "update archived post as editor (403 expected)", "request": {"method": "PATCH", "url": "{{baseUrl}}/items/posts/17",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer dr_static_editor_2b90d7fc1e6a4830"}],
      "body": {"mode": "raw", "raw": "{\"status\": \"published\"}"}}},
    {"name": "update post unknown field (400 expected)", "request": {"method": "PATCH", "url": "{{baseUrl}}/items/posts/12",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}],
      "body": {"mode": "raw", "raw": "{\"subtitle\": \"not a field\"}"}}},
    {"name": "delete post as editor (403 expected)", "request": {"method": "DELETE", "url": "{{baseUrl}}/items/posts/17",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_editor_2b90d7fc1e6a4830"}]}},
    {"name": "delete post as admin", "request": {"method": "DELETE", "url": "{{baseUrl}}/items/posts/17",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "list collections", "request": {"method": "GET", "url": "{{baseUrl}}/collections",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "get collection", "request": {"method": "GET", "url": "{{baseUrl}}/collections/posts",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "list fields for collection", "request": {"method": "GET", "url": "{{baseUrl}}/fields/job_openings",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "list users", "request": {"method": "GET", "url": "{{baseUrl}}/users?filter={\"status\":{\"_eq\":\"active\"}}&fields=id,first_name,last_name,email,role&sort=first_name",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "list users as editor (403 expected)", "request": {"method": "GET", "url": "{{baseUrl}}/users",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_editor_2b90d7fc1e6a4830"}]}},
    {"name": "get current user", "request": {"method": "GET", "url": "{{baseUrl}}/users/me",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_editor_2b90d7fc1e6a4830"}]}},
    {"name": "get current user as public (401 expected)", "request": {"method": "GET", "url": "{{baseUrl}}/users/me"}},
    {"name": "list roles", "request": {"method": "GET", "url": "{{baseUrl}}/roles",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "list permissions", "request": {"method": "GET", "url": "{{baseUrl}}/permissions",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "list files (token as query param)", "request": {"method": "GET", "url": "{{baseUrl}}/files?access_token=dr_static_editor_2b90d7fc1e6a4830&filter={\"type\":{\"_eq\":\"image/png\"}}"}},
    {"name": "get file", "request": {"method": "GET", "url": "{{baseUrl}}/files/3a7f92c1-6b04-4e58-9c31-8d70f2a5b6e9",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "list activity", "request": {"method": "GET", "url": "{{baseUrl}}/activity?filter={\"collection\":{\"_eq\":\"posts\"}}&limit=5",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "list flows", "request": {"method": "GET", "url": "{{baseUrl}}/flows",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}},
    {"name": "get settings", "request": {"method": "GET", "url": "{{baseUrl}}/settings",
      "header": [{"key": "Authorization", "value": "Bearer dr_static_admin_4f81c6a930b7e254"}]}}
  ]
}
