    },
    {
      "name": "attachment index out of range (404 expected)",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/mailbox/amelia.ortega/20260527T143055-0002/attach/3/invoice-INV-2026-0417.csv"}
    },
    {
      "name": "attachment index must be a number (400 expected)",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/mailbox/amelia.ortega/20260527T143055-0002/attach/first/invoice-INV-2026-0417.csv"}
    },
    {
      "name": "a message with no attachments at all (404 expected)",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/mailbox/jonas.pereira/20260527T164155-0004/attach/0/anything.txt"}
    },
