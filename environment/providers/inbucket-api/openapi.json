{
  "openapi": "3.1.0",
  "info": {
    "title": "Inbucket API (Mock)",
    "version": "3.1.0",
    "description": "Mock of Inbucket. There is no global inbox: every read names a mailbox, no endpoint lists all mail, and none lists the mailboxes either -- the monitor is the only cross-mailbox view. The mailbox is derived from the address rather than stored: under the local policy it is the local part, lowercased, with any +subaddress stripped, so Amelia.Ortega@orbit-labs.com, amelia.ortega+billing@orbit-labs.com and AMELIA.ORTEGA@acme-partner.example resolve to one mailbox. The {name} path segment accepts a bare mailbox name or a full address and puts both through the same policy. Every mailbox exists, so an unknown one is 200 with an empty list rather than a 404. A message to two recipients is stored once per mailbox, each copy with its own id and seen flag. Deletion is per-mailbox; nothing empties the server. Keys are hyphenated (posix-millis, content-type, download-link) and mailboxes list oldest first. Two endpoints are marked in their responses as mock additions: POST /api/v1/mailbox/{name} stands in for an SMTP delivery, and the monitor returns a snapshot rather than an SSE stream."
  },
  "paths": {
    "/audit/requests": {
      "get": {
        "summary": "Get Audit Requests",
        "description": "Return captured request/response logs.\n\nWARNING: the unpaginated default response embeds a full copy of every\nresponse body seen this session and grows without bound \u2014 late in a\nsession it can exceed what client tooling returns intact (long output\nis often silently capped). Prefer `/audit/summary` for an overview, or\npage through with `limit`/`offset` and `include_body=false` (drops the\nbulky `response_body` field; `request_body` is always kept).\n\nDefaults (no params = full dump, bodies included) are kept for\ncompatibility with the grading harness, which reads this endpoint\nparameter-less and asserts on response_body content.",
        "operationId": "get_audit_requests_audit_requests_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "include_body",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Include Body"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
