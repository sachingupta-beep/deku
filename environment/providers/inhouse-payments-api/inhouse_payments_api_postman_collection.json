        "body": {"mode": "raw", "raw": "{\"resolution\": \"maybe\"}"},
        "url": "{{baseUrl}}/v1/disputes/{{usdDispute}}/close"
      }
    },
    {
      "name": "close the USD dispute as won, returning the funds",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Idempotency-Key", "value": "run-close-usd-01"}
        ],
        "body": {"mode": "raw", "raw": "{\"resolution\": \"won\"}"},
        "url": "{{baseUrl}}/v1/disputes/{{usdDispute}}/close"
      }
    },
    {
      "name": "close the EUR dispute as lost, realising the chargeback",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Idempotency-Key", "value": "run-close-eur-01"}
        ],
        "body": {"mode": "raw", "raw": "{\"resolution\": \"lost\"}"},
        "url": "{{baseUrl}}/v1/disputes/{{eurDispute}}/close"
      }
    },
    {
      "name": "closing a closed dispute (409 expected)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Idempotency-Key", "value": "run-close-usd-02"}
        ],
        "body": {"mode": "raw", "raw": "{\"resolution\": \"lost\"}"},
        "url": "{{baseUrl}}/v1/disputes/{{usdDispute}}/close"
      }
