        "body": {"mode": "raw", "raw": "{\"evidence\": \"Second attempt.\"}"},
        "url": "{{baseUrl}}/v1/disputes/{{usdDispute}}/evidence"
      }
    },
    {
      "name": "a resolution must be won or lost (400 expected)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Idempotency-Key", "value": "run-close-bad-01"}
