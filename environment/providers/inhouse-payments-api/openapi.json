{
  "openapi": "3.1.0",
  "info": {
    "title": "Orbit Payments API (Mock)",
    "version": "2026-04-01",
    "description": "Mock of the Orbit Labs in-house payments service. Not a clone of a hosted processor: it is the shape a team ends up with when they build the ledger themselves. Every movement of money is double-entry -- captures, fees, refunds, disputes and payouts post balanced legs across gateway_clearing, merchant_revenue, processing_fees, disputed_funds and bank_settlement, and /v1/ledger/trial_balance proves debits equal credits per currency. The available balance is derived from those entries at read time rather than stored beside them. Idempotency keys are mandatory on every write: a POST without Idempotency-Key is a 400, replaying a key returns the original response with idempotent_replay true, and reusing one with a different body is a 409; only successes are recorded, so a declined card can be retried with the same key. Payments are an enforced state machine -- an illegal transition is a 409 naming the actions that are available -- and partial captures and refunds carry running totals so over-capture and over-refund are arithmetic. Each stored payment method carries a behaviour, so declines, step-up authentication and capture-time failures are reproducible. Amounts are integers in the currency's minor unit and always travel with their currency. Errors are a typed envelope with type, code, message and param; a declined card is 402 and carries the payment it created under resource."
  },
  "paths": {
    "/audit/requests": {
      "get": {
        "summary": "Get Audit Requests",
        "description": "Return captured request/response logs.\n\nWARNING: the unpaginated default response embeds a full copy of every\nresponse body seen this session and grows without bound \u2014 late in a\nsession it can exceed what client tooling returns intact (long output\nis often silently capped). Prefer `/audit/summary` for an overview, or\npage through with `limit`/`offset` and `include_body=false` (drops the\nbulky `response_body` field; `request_body` is always kept).\n\nDefaults (no params = full dump, bodies included) are kept for\ncompatibility with the grading harness, which reads this endpoint\nparameter-less and asserts on response_body content.",
        "operationId": "get_audit_requests_audit_requests_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "include_body",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Include Body"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
