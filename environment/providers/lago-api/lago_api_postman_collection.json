        "body": {"mode": "raw", "raw": "{\"credit_note\": {\"invoice_id\": \"inv_3f7e1b0c2d54f001\", \"reason\": \"vibes\", \"credit_amount_cents\": 100}}"},
        "url": "{{baseUrl}}/api/v1/credit_notes"
      }
    },
    {
      "name": "wallets",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/wallets"}
    },
    {
      "name": "one wallet",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/wallets/{{seedWallet}}"}
    },
    {
      "name": "grant prepaid credits",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"wallet\": {\"external_customer_id\": \"cust_helios\", \"name\": \"Helios pilot credits\", \"granted_credits\": 500, \"rate_amount_cents\": 100, \"expiration_at\": \"2027-05-01T00:00:00Z\"}}"},
        "url": "{{baseUrl}}/api/v1/wallets"
      }
    },
    {
      "name": "a wallet with no credits (422 expected)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"wallet\": {\"external_customer_id\": \"cust_helios\", \"granted_credits\": 0}}"},
        "url": "{{baseUrl}}/api/v1/wallets"
      }
    },
    {
      "name": "define a new metric",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"billable_metric\": {\"code\": \"storage_gb\", \"name\": \"Storage\", \"description\": \"Peak stored gigabytes\", \"aggregation_type\": \"max_agg\", \"field_name\": \"gb\", \"recurring\": true}}"},
        "url": "{{baseUrl}}/api/v1/billable_metrics"
      }
    },
    {
      "name": "an aggregation with nothing to aggregate (422 expected)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"billable_metric\": {\"code\": \"bad_metric\", \"aggregation_type\": \"sum_agg\"}}"},
        "url": "{{baseUrl}}/api/v1/billable_metrics"
      }
    },
    {
      "name": "an unknown aggregation type (422 expected)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"billable_metric\": {\"code\": \"bad_metric2\", \"aggregation_type\": \"vibes_agg\", \"field_name\": \"x\"}}"},
        "url": "{{baseUrl}}/api/v1/billable_metrics"
      }
    },
    {
      "name": "a metric code that already exists (422 expected)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"billable_metric\": {\"code\": \"api_calls\", \"aggregation_type\": \"count_agg\"}}"},
        "url": "{{baseUrl}}/api/v1/billable_metrics"
      }
    },
    {
      "name": "define a plan that charges it",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"plan\": {\"code\": \"orbit_archive\", \"name\": \"Orbit Archive\", \"interval\": \"monthly\", \"amount_cents\": 1900, \"amount_currency\": \"EUR\", \"charges\": [{\"billable_metric_code\": \"storage_gb\", \"charge_model\": \"standard\", \"properties\": {\"per_unit_amount_millicents\": 3000}}]}}"},
        "url": "{{baseUrl}}/api/v1/plans"
      }
    },
    {
      "name": "a plan with an unknown charge model (422 expected)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"plan\": {\"code\": \"orbit_bad\", \"interval\": \"monthly\", \"amount_cents\": 100, \"charges\": [{\"billable_metric_code\": \"storage_gb\", \"charge_model\": \"vibes\", \"properties\": {}}]}}"},
        "url": "{{baseUrl}}/api/v1/plans"
      }
    },
    {
      "name": "a graduated charge with no tiers (422 expected)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"plan\": {\"code\": \"orbit_bad2\", \"interval\": \"monthly\", \"amount_cents\": 100, \"charges\": [{\"billable_metric_code\": \"storage_gb\", \"charge_model\": \"graduated\", \"properties\": {}}]}}"},
        "url": "{{baseUrl}}/api/v1/plans"
      }
    },
    {
      "name": "a charge on a metric that does not exist (422 expected)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"plan\": {\"code\": \"orbit_bad3\", \"interval\": \"monthly\", \"amount_cents\": 100, \"charges\": [{\"billable_metric_code\": \"nope\", \"charge_model\": \"standard\", \"properties\": {\"per_unit_amount_millicents\": 1}}]}}"},
        "url": "{{baseUrl}}/api/v1/plans"
      }
    },
    {
      "name": "an unknown interval (422 expected)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"plan\": {\"code\": \"orbit_bad4\", \"interval\": \"fortnightly\", \"amount_cents\": 100}}"},
        "url": "{{baseUrl}}/api/v1/plans"
      }
    },
    {
      "name": "upsert a customer on the id you own",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"customer\": {\"external_id\": \"cust_helios\", \"name\": \"Helios Robotics AG\", \"city\": \"Munich\"}}"},
        "url": "{{baseUrl}}/api/v1/customers"
      }
    },
    {
      "name": "the lago_id survived the upsert",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/customers/{{helios}}"}
    },
    {
      "name": "a customer with no external_id (422 expected)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"customer\": {\"name\": \"Nameless\"}}"},
        "url": "{{baseUrl}}/api/v1/customers"
      }
    },
    {
      "name": "subscribe them to the new plan",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"subscription\": {\"external_id\": \"sub_helios_archive\", \"external_customer_id\": \"cust_helios\", \"plan_code\": \"orbit_archive\", \"billing_time\": \"calendar\", \"current_period_from\": \"2026-05-01T00:00:00Z\", \"current_period_to\": \"2026-06-01T00:00:00Z\"}}"},
        "url": "{{baseUrl}}/api/v1/subscriptions"
      }
    },
    {
      "name": "meter against it",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"event\": {\"transaction_id\": \"run-helios-storage-1\", \"external_subscription_id\": \"sub_helios_archive\", \"code\": \"storage_gb\", \"timestamp\": \"2026-05-20T00:00:00Z\", \"properties\": {\"gb\": 340}}}"},
        "url": "{{baseUrl}}/api/v1/events"
      }
    },
    {
      "name": "and read the usage back",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/customers/{{helios}}/current_usage?external_subscription_id=sub_helios_archive"}
    },
    {
      "name": "a plan in the wrong currency for the customer (422 expected)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"subscription\": {\"external_id\": \"sub_helios_scale\", \"external_customer_id\": \"cust_helios\", \"plan_code\": \"orbit_scale\"}}"},
        "url": "{{baseUrl}}/api/v1/subscriptions"
      }
    },
    {
      "name": "a subscription id that is taken (422 expected)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"subscription\": {\"external_id\": \"sub_helios_archive\", \"external_customer_id\": \"cust_helios\", \"plan_code\": \"orbit_archive\"}}"},
        "url": "{{baseUrl}}/api/v1/subscriptions"
      }
    },
    {
      "name": "an unknown plan (404 expected)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"subscription\": {\"external_id\": \"sub_helios_nope\", \"external_customer_id\": \"cust_helios\", \"plan_code\": \"nope\"}}"},
        "url": "{{baseUrl}}/api/v1/subscriptions"
      }
    },
    {
      "name": "terminate it",
      "request": {"method": "DELETE", "url": "{{baseUrl}}/api/v1/subscriptions/sub_helios_archive"}
    },
    {
      "name": "terminating it again (422 expected)",
      "request": {"method": "DELETE", "url": "{{baseUrl}}/api/v1/subscriptions/sub_helios_archive"}
    },
    {
      "name": "terminating an unknown subscription (404 expected)",
      "request": {"method": "DELETE", "url": "{{baseUrl}}/api/v1/subscriptions/sub_nope"}
    },
    {
      "name": "gross revenue by month and currency",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/analytics/gross_revenue"}
    },
    {
      "name": "MRR, plan fees only",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/analytics/mrr"}
    },
    {
      "name": "MRR in one currency",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/analytics/mrr?currency=EUR"}
    },
    {
      "name": "audit trail of this run",
