{
  "openapi": "3.1.0",
  "info": {
    "title": "Lago API (Mock)",
    "version": "1.17.0",
    "description": "Mock of Lago, open-source usage-based billing. Nothing here charges anyone: POST /api/v1/events ingests usage, and what it costs is computed later by aggregating the period's events and running the plan's charges over the result. The aggregation type decides what 'how much' means -- sum_agg adds a property up, max_agg takes the peak, unique_count_agg counts distinct values, count_agg counts events. The charge model decides what that number costs, and the five models disagree wildly on the same units: graduated bills each tier at its own rate, volume finds the one tier the whole quantity falls in and bills all of it there, package sells blocks, percentage takes basis points of a monetary metric, standard is a flat per-unit rate. GET /api/v1/customers/{id}/current_usage recomputes the open period on every read, before any invoice exists. Ingestion is idempotent on the caller's own transaction_id and a batch is all-or-nothing. Identity is dual -- a lago_id the service owns and an external_id the caller owns -- responses are wrapped, and errors carry a per-field error_details map. Amounts are integer cents; per-unit rates are millicents (1 cent = 1000) so sub-cent rates stay exact without floats."
  },
  "paths": {
    "/audit/requests": {
      "get": {
        "summary": "Get Audit Requests",
        "description": "Return captured request/response logs.\n\nWARNING: the unpaginated default response embeds a full copy of every\nresponse body seen this session and grows without bound \u2014 late in a\nsession it can exceed what client tooling returns intact (long output\nis often silently capped). Prefer `/audit/summary` for an overview, or\npage through with `limit`/`offset` and `include_body=false` (drops the\nbulky `response_body` field; `request_body` is always kept).\n\nDefaults (no params = full dump, bodies included) are kept for\ncompatibility with the grading harness, which reads this endpoint\nparameter-less and asserts on response_body content.",
        "operationId": "get_audit_requests_audit_requests_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "include_body",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Include Body"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
