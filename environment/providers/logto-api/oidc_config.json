{
  "issuer": "https://auth.orbit-labs.com/oidc",
  "tenantId": "orbit-labs",
  "logtoVersion": "1.23.0",
  "responseTypesSupported": ["code"],
  "grantTypesSupported": ["authorization_code", "refresh_token", "client_credentials"],
  "subjectTypesSupported": ["public"],
  "idTokenSigningAlgValuesSupported": ["ES384"],
  "scopesSupported": ["openid", "offline_access", "profile", "email", "phone", "roles", "urn:logto:scope:organizations", "urn:logto:scope:organization_roles"],
  "claimsSupported": ["sub", "iss", "aud", "exp", "iat", "at_hash", "name", "picture", "username", "email", "email_verified", "phone_number", "phone_number_verified", "roles", "organizations", "organization_roles"],
  "codeChallengeMethodsSupported": ["S256"],
  "tokenEndpointAuthMethodsSupported": ["client_secret_basic", "client_secret_post", "none"],
  "organizationTokenAudiencePrefix": "urn:logto:organization:",
  "defaultAccessTokenTtl": 3600,
  "defaultRefreshTokenTtl": 1209600
}
