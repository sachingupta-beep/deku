{
  "openapi": "3.1.0",
  "info": {
    "title": "MailCatcher API (Mock)",
    "version": "0.10.0",
    "description": "Mock of MailCatcher, a Ruby/Sinatra capture tool and the smallest surface of the mail services here. The minimalism is the identity: no search, no tags, no read state, no mailboxes, no sessions, no settings -- everything hangs off /messages. What it does have is distinctive. The format is a file extension rather than a path segment: /messages/1.json, .html, .plain, .source, .eml, and which of those a given message offers is advertised in its formats array. Ids are plain integers in arrival order, and they start again at 1 after the catcher is cleared. Addresses come back angle-bracketed as the envelope wrote them, so a null return path is the literal <>. Attachments are addressed by Content-ID, not by index, filename or MIME section number. And .html rewrites cid: references to /messages/{id}/parts/{cid}, so what it serves is directly renderable. Keys are snake_case and size is a string, because Ruby serialised them that way. One endpoint is marked in its response as a mock addition: POST /messages stands in for the SMTP delivery a mock cannot accept."
  },
  "paths": {
    "/audit/requests": {
      "get": {
        "summary": "Get Audit Requests",
        "description": "Return captured request/response logs.\n\nWARNING: the unpaginated default response embeds a full copy of every\nresponse body seen this session and grows without bound \u2014 late in a\nsession it can exceed what client tooling returns intact (long output\nis often silently capped). Prefer `/audit/summary` for an overview, or\npage through with `limit`/`offset` and `include_body=false` (drops the\nbulky `response_body` field; `request_body` is always kept).\n\nDefaults (no params = full dump, bodies included) are kept for\ncompatibility with the grading harness, which reads this endpoint\nparameter-less and asserts on response_body content.",
        "operationId": "get_audit_requests_audit_requests_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "include_body",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Include Body"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
