{
  "openapi": "3.1.0",
  "info": {
    "title": "MailHog API (Mock)",
    "version": "v1.0.1",
    "description": "Mock of MailHog, which captures mail instead of delivering it. Addresses are structured Path objects (Relays, Mailbox, Domain, Params) because what was captured is the SMTP envelope. The same messages are served two ways: /api/v1/messages as a bare array and /api/v2/messages as a paginated envelope. MIME parts are individually addressable for download. Jim, the chaos monkey, is off until enabled and then injects deterministic failures into the release endpoint."
  },
  "paths": {
    "/audit/requests": {
      "get": {
        "summary": "Get Audit Requests",
        "description": "Return captured request/response logs.\n\nWARNING: the unpaginated default response embeds a full copy of every\nresponse body seen this session and grows without bound \u2014 late in a\nsession it can exceed what client tooling returns intact (long output\nis often silently capped). Prefer `/audit/summary` for an overview, or\npage through with `limit`/`offset` and `include_body=false` (drops the\nbulky `response_body` field; `request_body` is always kept).\n\nDefaults (no params = full dump, bodies included) are kept for\ncompatibility with the grading harness, which reads this endpoint\nparameter-less and asserts on response_body content.",
        "operationId": "get_audit_requests_audit_requests_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "include_body",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Include Body"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
