{
  "openapi": "3.1.0",
  "info": {
    "title": "Mailpit API (Mock)",
    "version": "v1.21.3",
    "description": "Mock of Mailpit, MailHog's successor. Four things shape the API. Search is a real query language: prefixed terms (from:, to:, cc:, bcc:, reply-to:, addressed:, subject:, message-id:, tag:, before:, after:), is:/has: flags, quoted phrases and negation with - or !, all ANDed. Messages carry state: read/unread is tracked and mutable, and reading a message marks it read; tags are settable, renameable, deletable and searchable. Mailpit analyses what it captured through html-check, link-check and sa-check. Chaos configures an SMTP error code and a whole percentage per trigger (Sender, Recipient, Authentication), with the roll seeded from the address so it is deterministic. Note the singular/plural split: /api/v1/messages is the list, /api/v1/message/{ID} is the read."
  },
  "paths": {
    "/audit/requests": {
      "get": {
        "summary": "Get Audit Requests",
        "description": "Return captured request/response logs.\n\nWARNING: the unpaginated default response embeds a full copy of every\nresponse body seen this session and grows without bound \u2014 late in a\nsession it can exceed what client tooling returns intact (long output\nis often silently capped). Prefer `/audit/summary` for an overview, or\npage through with `limit`/`offset` and `include_body=false` (drops the\nbulky `response_body` field; `request_body` is always kept).\n\nDefaults (no params = full dump, bodies included) are kept for\ncompatibility with the grading harness, which reads this endpoint\nparameter-less and asserts on response_body content.",
        "operationId": "get_audit_requests_audit_requests_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "include_body",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Include Body"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
