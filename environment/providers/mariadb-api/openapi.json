  "components": {
    "schemas": {
      "ExplainBody": {
        "properties": {
          "sql": {
            "type": "string",
            "title": "Sql"
          },
          "analyze": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analyze",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "sql"
        ],
        "title": "ExplainBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "StatementBody": {
        "properties": {
          "sql": {
            "type": "string",
            "title": "Sql"
          },
          "params": {
            "anyOf": [
              {
                "items": {},
                "type": "array"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Params"
          },
          "max_rows": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Rows",
            "default": 1000
          }
        },
        "type": "object",
        "required": [
          "sql"
        ],
        "title": "StatementBody"
      },
      "TransactionBody": {
        "properties": {
          "statements": {
            "items": {
              "$ref": "#/components/schemas/TransactionStatement"
            },
            "type": "array",
            "title": "Statements"
          },
          "isolation_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Isolation Level",
            "default": "REPEATABLE READ"
          }
        },
        "type": "object",
        "required": [
          "statements"
        ],
        "title": "TransactionBody"
      },
      "TransactionStatement": {
        "properties": {
          "sql": {
            "type": "string",
            "title": "Sql"
          },
          "params": {
            "anyOf": [
              {
                "items": {},
                "type": "array"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Params"
          }
        },
        "type": "object",
        "required": [
