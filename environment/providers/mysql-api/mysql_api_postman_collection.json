          "raw": "{\"sql\": \"SELECT p.sku, p.name, v.on_hand, v.reserved, v.reorder_point FROM inventory v JOIN products p ON p.id = v.product_id WHERE v.on_hand - v.reserved <= v.reorder_point AND v.warehouse <> 'DIGITAL' ORDER BY v.on_hand\"}"
        }
      }
