        "body": {
          "mode": "raw",
          "raw": "{\"sql\": \"SELECT sku, IF(active = 1, 'live', 'retired') AS state FROM products ORDER BY id\"}"
        }
      }
    },
    {
      "name": "query with placeholders",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/query",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"sql\": \"SELECT id, status, total_cents FROM orders WHERE status = ? AND currency = ?\", \"params\": [\"delivered\", \"EUR\"]}"
        }
      }
    },
    {
      "name": "query join and aggregate",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/query",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"sql\": \"SELECT c.country, COUNT(*) AS orders, SUM(o.total_cents) AS cents FROM orders o JOIN customers c ON c.id = o.customer_id GROUP BY c.country ORDER BY cents DESC\"}"
        }
      }
    },
    {
      "name": "query revenue by product",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/query",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"sql\": \"SELECT p.sku, p.name, SUM(i.quantity) AS units, SUM(i.quantity * i.unit_price_cents - i.discount_cents) AS revenue_cents FROM order_items i JOIN products p ON p.id = i.product_id GROUP BY p.id ORDER BY revenue_cents DESC LIMIT 5\"}"
        }
      }
    },
    {
