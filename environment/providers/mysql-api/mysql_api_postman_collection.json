{
  "info": {
    "name": "MySQL Mock API 8.0",
    "description": "Test collection for the mock MySQL HTTP service. Base URL defaults to http://localhost:8110. In docker-compose, the service is reachable at http://mysql-api:8110. Statements are executed by a real SQL engine and reported with MySQL error numbers plus SQLSTATE. The X-MySQL-User header selects the account and grants are enforced against it: root (all privileges), orbit_shop (default, SELECT/INSERT/UPDATE/DELETE), orbit_report (SELECT only), orbit_etl (SELECT on customers, orders, order_items and products only), orbit_legacy (locked).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8110"
    }
  ],
