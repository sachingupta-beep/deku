[
  {
    "id": "default",
    "isDefault": "1",
    "url": "file:///etc/config/kratos/identity.default.schema.json",
    "schema": {
      "$id": "https://orbit-labs.com/schemas/identity.default.json",
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Orbit Labs staff",
      "type": "object",
      "properties": {
        "traits": {
          "type": "object",
          "properties": {
            "email": {"type": "string", "format": "email", "title": "E-Mail",
                      "minLength": 3,
                      "ory.sh/kratos": {"credentials": {"password": {"identifier": true}},
                                        "verification": {"via": "email"},
                                        "recovery": {"via": "email"}}},
            "name": {"type": "object", "properties": {
              "first": {"type": "string", "title": "First name", "minLength": 1},
              "last": {"type": "string", "title": "Last name", "minLength": 1}},
              "required": ["first", "last"]},
            "role": {"type": "string", "title": "Role",
                     "enum": ["owner", "engineer", "support", "service"]},
            "seat_id": {"type": "string", "title": "Seat id",
                        "pattern": "^SEAT-[0-9]{3}$"}
          },
          "required": ["email", "name"],
          "additionalProperties": false
        }
      }
    }
  },
  {
    "id": "partner",
    "isDefault": "0",
    "url": "file:///etc/config/kratos/identity.partner.schema.json",
    "schema": {
      "$id": "https://orbit-labs.com/schemas/identity.partner.json",
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Orbit partner contact",
      "type": "object",
      "properties": {
        "traits": {
          "type": "object",
          "properties": {
            "email": {"type": "string", "format": "email", "title": "E-Mail",
                      "minLength": 3,
                      "ory.sh/kratos": {"credentials": {"password": {"identifier": true}},
                                        "verification": {"via": "email"},
                                        "recovery": {"via": "email"}}},
            "company": {"type": "string", "title": "Company", "minLength": 2}
          },
          "required": ["email", "company"],
          "additionalProperties": false
        }
      }
    }
  }
]
