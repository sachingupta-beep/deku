{
  "info": {
    "name": "PocketBase Mock API v0.24",
    "description": "Test collection for the mock PocketBase service. Base URL defaults to http://localhost:8103. In docker-compose, the service is reachable at http://pocketbase-api:8103. The Authorization header carries a PocketBase token: the superuser token (eyJhbGciOiJIUzI1NiJ9.superuser.orbit-labs-status) bypasses collection rules, any other token authenticates as record usramelia000001, and no header is a guest.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8103"}
  ],
  "item": [
    {"name": "health", "request": {"method": "GET", "url": "{{baseUrl}}/health"}},
    {"name": "api health", "request": {"method": "GET", "url": "{{baseUrl}}/api/health"}},
    {"name": "list collections", "request": {"method": "GET", "url": "{{baseUrl}}/api/collections?perPage=10",
      "header": [{"key": "Authorization", "value": "eyJhbGciOiJIUzI1NiJ9.superuser.orbit-labs-status"}]}},
    {"name": "list collections as guest (403 expected)", "request": {"method": "GET", "url": "{{baseUrl}}/api/collections"}},
    {"name": "get collection", "request": {"method": "GET", "url": "{{baseUrl}}/api/collections/incidents",
      "header": [{"key": "Authorization", "value": "eyJhbGciOiJIUzI1NiJ9.superuser.orbit-labs-status"}]}},
    {"name": "list services (public rule)", "request": {"method": "GET", "url": "{{baseUrl}}/api/collections/services/records?sort=sort_order&perPage=10"}},
    {"name": "list open incidents (filter)", "request": {"method": "GET", "url": "{{baseUrl}}/api/collections/incidents/records?filter=status!=\"resolved\"&sort=-started"}},
    {"name": "list incidents with expand", "request": {"method": "GET", "url": "{{baseUrl}}/api/collections/incidents/records?filter=severity<=2 %26%26 status=\"monitoring\"&expand=service,assignee"}},
    {"name": "list incidents fields projection", "request": {"method": "GET", "url": "{{baseUrl}}/api/collections/incidents/records?fields=id,title,status,severity&perPage=3&skipTotal=true"}},
    {"name": "get incident", "request": {"method": "GET", "url": "{{baseUrl}}/api/collections/incidents/records/incident0000001?expand=service"}},
    {"name": "get incident (404 expected)", "request": {"method": "GET", "url": "{{baseUrl}}/api/collections/incidents/records/incident0000099"}},
    {"name": "list incident updates for incident", "request": {"method": "GET", "url": "{{baseUrl}}/api/collections/incident_updates/records?filter=incident=\"incident0000001\"&sort=posted&expand=author"}},
    {"name": "search incidents (like)", "request": {"method": "GET", "url": "{{baseUrl}}/api/collections/incidents/records?filter=title~\"latency\" %7C%7C impact~\"outage\"&sort=-started"}},
    {"name": "list users as guest (403 expected)", "request": {"method": "GET", "url": "{{baseUrl}}/api/collections/users/records"}},
    {"name": "list users authenticated", "request": {"method": "GET", "url": "{{baseUrl}}/api/collections/users/records?filter=oncall=true",
      "header": [{"key": "Authorization", "value": "eyJhbGciOiJIUzI1NiJ9.users_amelia.orbit-labs-status"}]}},
    {"name": "list subscribers as guest (403 expected)", "request": {"method": "GET", "url": "{{baseUrl}}/api/collections/subscribers/records"}},
    {"name": "list subscribers as superuser", "request": {"method": "GET", "url": "{{baseUrl}}/api/collections/subscribers/records?filter=confirmed=false",
      "header": [{"key": "Authorization", "value": "eyJhbGciOiJIUzI1NiJ9.superuser.orbit-labs-status"}]}},
    {"name": "create subscriber (public create rule)", "request": {"method": "POST", "url": "{{baseUrl}}/api/collections/subscribers/records",
      "header": [{"key": "Content-Type", "value": "application/json"}],
      "body": {"mode": "raw", "raw": "{\"email\": \"ops@nimbus.coffee\", \"name\": \"Nimbus Coffee Ops\", \"services\": [\"svcauthapi00001\"], \"confirmed\": false, \"subscribed\": \"2026-05-26 09:00:00.000Z\"}"}}},
    {"name": "create subscriber missing email (400 expected)", "request": {"method": "POST", "url": "{{baseUrl}}/api/collections/subscribers/records",
      "header": [{"key": "Content-Type", "value": "application/json"}],
      "body": {"mode": "raw", "raw": "{\"name\": \"No Email\", \"subscribed\": \"2026-05-26 09:00:00.000Z\"}"}}},
    {"name": "create incident as guest (403 expected)", "request": {"method": "POST", "url": "{{baseUrl}}/api/collections/incidents/records",
      "header": [{"key": "Content-Type", "value": "application/json"}],
      "body": {"mode": "raw", "raw": "{\"title\": \"Unauthorized\", \"service\": \"svcauthapi00001\", \"status\": \"investigating\", \"severity\": 3, \"started\": \"2026-05-26 09:00:00.000Z\"}"}}},
    {"name": "create incident as superuser", "request": {"method": "POST", "url": "{{baseUrl}}/api/collections/incidents/records",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "eyJhbGciOiJIUzI1NiJ9.superuser.orbit-labs-status"}],
      "body": {"mode": "raw", "raw": "{\"title\": \"Webhook delivery retries climbing\", \"service\": \"svcbillingapi02\", \"status\": \"investigating\", \"severity\": 3, \"impact\": \"Outbound webhooks retry up to 4 times before succeeding.\", \"assignee\": \"usrhelena000003\", \"started\": \"2026-05-26 09:05:00.000Z\"}"}}},
    {"name": "create incident bad relation (400 expected)", "request": {"method": "POST", "url": "{{baseUrl}}/api/collections/incidents/records",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "eyJhbGciOiJIUzI1NiJ9.superuser.orbit-labs-status"}],
      "body": {"mode": "raw", "raw": "{\"title\": \"Orphan incident\", \"service\": \"svcdoesnotexist\", \"status\": \"investigating\", \"severity\": 3, \"started\": \"2026-05-26 09:05:00.000Z\"}"}}},
    {"name": "update incident", "request": {"method": "PATCH", "url": "{{baseUrl}}/api/collections/incidents/records/incident0000001",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "eyJhbGciOiJIUzI1NiJ9.superuser.orbit-labs-status"}],
      "body": {"mode": "raw", "raw": "{\"status\": \"resolved\", \"resolved\": \"2026-05-26 08:45:00.000Z\"}"}}},
    {"name": "update service status", "request": {"method": "PATCH", "url": "{{baseUrl}}/api/collections/services/records/svcauthapi00001",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "eyJhbGciOiJIUzI1NiJ9.superuser.orbit-labs-status"}],
      "body": {"mode": "raw", "raw": "{\"status\": \"operational\"}"}}},
    {"name": "delete subscriber", "request": {"method": "DELETE", "url": "{{baseUrl}}/api/collections/subscribers/records/subscriber00004",
      "header": [{"key": "Authorization", "value": "eyJhbGciOiJIUzI1NiJ9.superuser.orbit-labs-status"}]}},
    {"name": "get file metadata", "request": {"method": "GET", "url": "{{baseUrl}}/api/files/users/usramelia000001/amelia_9dK2c.png"}},
    {"name": "get incident attachment", "request": {"method": "GET", "url": "{{baseUrl}}/api/files/incidents/incident0000001/flamegraph_2Qb9.svg?thumb=100x100"}},
    {"name": "get file (404 expected)", "request": {"method": "GET", "url": "{{baseUrl}}/api/files/users/usramelia000001/missing.png"}},
    {"name": "create file token", "request": {"method": "POST", "url": "{{baseUrl}}/api/files/token",
      "header": [{"key": "Authorization", "value": "eyJhbGciOiJIUzI1NiJ9.users_amelia.orbit-labs-status"}]}},
    {"name": "list logs", "request": {"method": "GET", "url": "{{baseUrl}}/api/logs?perPage=5&filter=status>=400",
      "header": [{"key": "Authorization", "value": "eyJhbGciOiJIUzI1NiJ9.superuser.orbit-labs-status"}]}},
    {"name": "log stats", "request": {"method": "GET", "url": "{{baseUrl}}/api/logs/stats",
      "header": [{"key": "Authorization", "value": "eyJhbGciOiJIUzI1NiJ9.superuser.orbit-labs-status"}]}},
    {"name": "list backups", "request": {"method": "GET", "url": "{{baseUrl}}/api/backups",
      "header": [{"key": "Authorization", "value": "eyJhbGciOiJIUzI1NiJ9.superuser.orbit-labs-status"}]}},
    {"name": "create backup", "request": {"method": "POST", "url": "{{baseUrl}}/api/backups",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "eyJhbGciOiJIUzI1NiJ9.superuser.orbit-labs-status"}],
      "body": {"mode": "raw", "raw": "{\"name\": \"pb_backup_orbit_status_manual.zip\"}"}}},
    {"name": "delete backup", "request": {"method": "DELETE", "url": "{{baseUrl}}/api/backups/pb_backup_orbit_status_pre_upgrade.zip",
      "header": [{"key": "Authorization", "value": "eyJhbGciOiJIUzI1NiJ9.superuser.orbit-labs-status"}]}},
    {"name": "list crons", "request": {"method": "GET", "url": "{{baseUrl}}/api/crons",
      "header": [{"key": "Authorization", "value": "eyJhbGciOiJIUzI1NiJ9.superuser.orbit-labs-status"}]}},
    {"name": "get settings", "request": {"method": "GET", "url": "{{baseUrl}}/api/settings",
      "header": [{"key": "Authorization", "value": "eyJhbGciOiJIUzI1NiJ9.superuser.orbit-labs-status"}]}},
    {"name": "realtime subscribe", "request": {"method": "POST", "url": "{{baseUrl}}/api/realtime",
      "header": [{"key": "Content-Type", "value": "application/json"}],
      "body": {"mode": "raw", "raw": "{\"clientId\": \"statuspageclient1\", \"subscriptions\": [\"incidents\", \"services\"]}"}}},
    {"name": "realtime subscribe unknown topic (400 expected)", "request": {"method": "POST", "url": "{{baseUrl}}/api/realtime",
      "header": [{"key": "Content-Type", "value": "application/json"}],
      "body": {"mode": "raw", "raw": "{\"clientId\": \"statuspageclient2\", \"subscriptions\": [\"deployments\"]}"}}},
    {"name": "list realtime subscriptions", "request": {"method": "GET", "url": "{{baseUrl}}/api/realtime",
      "header": [{"key": "Authorization", "value": "eyJhbGciOiJIUzI1NiJ9.superuser.orbit-labs-status"}]}}
  ]
}
