{
  "openapi": "3.1.0",
  "info": {
    "title": "PocketBase Auth API (Mock)",
    "version": "v0.24.4",
    "description": "Mock of the auth half of the self-hosted PocketBase instance pocketbase-api backs. Auth is per collection: /api/collections/{collection}/... with the users collection and the system _superusers collection carrying their own identity fields, password rules, OTP/MFA switches and OAuth2 providers. Tokens are <header>.<recordId>.<tokenKey> and resolve only while the record still carries that tokenKey, so a password or email change invalidates every token already issued for it."
  },
  "paths": {
    "/audit/requests": {
      "get": {
        "summary": "Get Audit Requests",
        "description": "Return captured request/response logs.\n\nWARNING: the unpaginated default response embeds a full copy of every\nresponse body seen this session and grows without bound \u2014 late in a\nsession it can exceed what client tooling returns intact (long output\nis often silently capped). Prefer `/audit/summary` for an overview, or\npage through with `limit`/`offset` and `include_body=false` (drops the\nbulky `response_body` field; `request_body` is always kept).\n\nDefaults (no params = full dump, bodies included) are kept for\ncompatibility with the grading harness, which reads this endpoint\nparameter-less and asserts on response_body content.",
        "operationId": "get_audit_requests_audit_requests_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "include_body",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Include Body"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
