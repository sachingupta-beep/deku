{
  "info": {
    "name": "PocketBase Auth Mock API v0.24.4",
    "description": "Test collection for the mock PocketBase auth service. Base URL defaults to http://localhost:8114. In docker-compose, the service is reachable at http://pocketbase-auth-api:8114. This is the auth half of the same instance pocketbase-api backs, so record ids match. PocketBase authenticates per collection: `users` allows email or username identities, OTP, MFA and OAuth2 and carries authRule `verified = true`; the system `_superusers` collection allows only an email identity and password. Tokens are `<header>.<recordId>.<tokenKey>` and resolve only while the record still carries that tokenKey, so a password or email change invalidates every token already issued for it. Seed passwords are listed in settings.json under seed_credentials. Requests labelled '(N expected)' assert an error path.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8114"
    }
  ],
