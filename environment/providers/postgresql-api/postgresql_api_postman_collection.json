        "body": {
          "mode": "raw",
          "raw": "{\"sql\": \"SELECT name, plan FROM organizations WHERE name ILIKE '%robotics%' AND seats::int > 10\"}"
        }
      }
    },
    {
      "name": "query jsonb field access",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/query",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"sql\": \"SELECT slug, settings ->> 'retention_days' AS retention_days, settings ->> 'sso' AS sso FROM organizations ORDER BY slug\"}"
        }
      }
    },
    {
      "name": "query join and aggregate",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/query",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"sql\": \"SELECT o.name, SUM(r.requests) AS requests, SUM(r.errors) AS errors FROM request_stats r JOIN organizations o ON o.id = r.org_id GROUP BY o.name ORDER BY requests DESC\"}"
        }
      }
    },
    {
      "name": "query error rate with a window function",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/query",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"sql\": \"SELECT e.path, r.requests, r.errors, ROUND(100.0 * r.errors / NULLIF(r.requests, 0), 3) AS error_pct, RANK() OVER (ORDER BY r.errors DESC) AS worst FROM request_stats r JOIN endpoints e ON e.id = r.endpoint_id WHERE r.day = '2026-05-26' ORDER BY worst LIMIT 5\"}"
        }
      }
    },
    {
      "name": "query with a CTE",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/query",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"sql\": \"WITH failing AS (SELECT webhook_id, COUNT(*) AS failures FROM webhook_deliveries WHERE status IN ('failed', 'retrying') GROUP BY webhook_id) SELECT w.url, w.active, failing.failures FROM webhooks w JOIN failing ON failing.webhook_id = w.id ORDER BY failing.failures DESC\"}"
        }
      }
    },
