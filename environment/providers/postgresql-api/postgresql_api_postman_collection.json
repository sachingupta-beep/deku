{
  "info": {
    "name": "PostgreSQL Mock API 15",
    "description": "Test collection for the mock PostgreSQL HTTP service. Base URL defaults to http://localhost:8109. In docker-compose, the service is reachable at http://postgresql-api:8109. Statements are executed by a real SQL engine and reported with PostgreSQL SQLSTATE codes. The X-DB-Role header selects the cluster role and table GRANTs are enforced against it: postgres (superuser), orbit_app (default, read/write), orbit_readonly (SELECT only), orbit_analytics (no access to webhooks or api_keys).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8109"
    }
  ],
  "item": [
