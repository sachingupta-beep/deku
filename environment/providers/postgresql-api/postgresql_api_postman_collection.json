            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"sql\": \"SELECT slug, seats FROM organizations WHERE plan = $1 AND seats >= $2 ORDER BY slug\", \"params\": [\"enterprise\", 10]}"
        }
      }
    },
    {
      "name": "query with ILIKE and a cast",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/query",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
