                "additionalProperties": true,
                "default": {},
                "title": "Body",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Invoke Function Functions V1  Slug  Post"
