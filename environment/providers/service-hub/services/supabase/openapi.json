{
  "components": {
    "schemas": {
      "BroadcastBody": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/BroadcastMessage"
            },
            "title": "Messages",
            "type": "array"
          }
        },
        "required": [
          "messages"
        ],
        "title": "BroadcastBody",
        "type": "object"
      },
      "BroadcastMessage": {
        "properties": {
          "event": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "broadcast",
            "title": "Event"
          },
          "payload": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payload"
          },
          "topic": {
            "description": "Channel name, e.g. 'room:orbit-standup'",
            "title": "Topic",
            "type": "string"
          }
        },
        "required": [
          "topic"
        ],
        "title": "BroadcastMessage",
        "type": "object"
      },
      "BucketCreateBody": {
        "properties": {
          "allowed_mime_types": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Allowed Mime Types"
          },
          "file_size_limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Per-object byte cap",
            "title": "File Size Limit"
          },
          "id": {
            "description": "Bucket id, unique within the project",
            "examples": [
              "exports"
            ],
            "title": "Id",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Display name; defaults to the id",
            "title": "Name"
          },
          "public": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": false,
            "description": "Public buckets are readable by anon",
            "title": "Public"
          }
        },
        "required": [
          "id"
        ],
        "title": "BucketCreateBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ObjectListBody": {
        "properties": {
          "limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": 100,
            "title": "Limit"
          },
          "offset": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": 0,
            "title": "Offset"
          },
          "prefix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "",
            "description": "Path prefix filter, e.g. 'invoices/'",
            "title": "Prefix"
          }
        },
        "title": "ObjectListBody",
        "type": "object"
      },
      "SignBody": {
        "properties": {
          "expiresIn": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": 3600,
            "description": "Seconds until the signed URL expires",
            "title": "Expiresin"
          }
        },
        "title": "SignBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Self-hosted Supabase data plane: PostgREST at /rest/v1 with horizontal filtering, resource embedding and RLS; Storage buckets and objects; Edge Functions; Realtime channels and broadcast; and the project read model. GoTrue is the separate `supabase-auth` service.\n\nSimulated Supabase (self-host) served by Service Hub under `/supabase`. Upstream reference: https://supabase.com/docs/reference/api.",
    "summary": "Self-hosted Supabase data plane: PostgREST at /rest/v1 with horizontal filtering, resource embedding and RLS; Storage buckets and objects; Edge Functions; Realtime channels and broadcast; and the project read model. GoTrue is the separate `supabase-auth` service.",
    "title": "Supabase (self-host) (simulated)",
    "version": "v1"
  },
