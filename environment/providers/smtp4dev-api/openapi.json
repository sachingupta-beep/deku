{
  "openapi": "3.1.0",
  "info": {
    "title": "smtp4dev API (Mock)",
    "version": "3.8.6",
    "description": "Mock of smtp4dev, a .NET capture tool whose contracts differ from the other mail mocks in five ways. Lists are PagedResults -- results, firstRowOnPage, lastRowOnPage, currentPage, pageCount, pageSize, rowCount -- driven by page (1-based), pageSize, sortColumn and sortIsDescending, not by a start offset. Sessions are first-class peers of messages: a session is the SMTP conversation kept with its full transcript, including ones that produced no message because authentication failed or the client hung up after a rejected recipient. Mailboxes are recipient-matching rules with Default as the catch-all, so smtp4dev routes to a mailbox rather than deriving one. MIME parts form a tree addressed by section number (1, 1.1, 1.1.2), and a container part has children rather than content. The server settings are writable: POST /api/Server is the Settings dialog, and lowering numberOfMessagesToKeep trims the store immediately. The delete-everything routes are spelled with a literal *. One endpoint is marked in its response as a mock addition: POST /api/Messages stands in for the SMTP delivery a mock cannot accept."
  },
  "paths": {
    "/audit/requests": {
      "get": {
        "summary": "Get Audit Requests",
        "description": "Return captured request/response logs.\n\nWARNING: the unpaginated default response embeds a full copy of every\nresponse body seen this session and grows without bound \u2014 late in a\nsession it can exceed what client tooling returns intact (long output\nis often silently capped). Prefer `/audit/summary` for an overview, or\npage through with `limit`/`offset` and `include_body=false` (drops the\nbulky `response_body` field; `request_body` is always kept).\n\nDefaults (no params = full dump, bodies included) are kept for\ncompatibility with the grading harness, which reads this endpoint\nparameter-less and asserts on response_body content.",
        "operationId": "get_audit_requests_audit_requests_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "include_body",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Include Body"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
