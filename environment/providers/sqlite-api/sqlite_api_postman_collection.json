{
  "info": {
    "name": "SQLite Mock API v1",
    "description": "Test collection for the mock SQLite HTTP service. Base URL defaults to http://localhost:8108. In docker-compose, the service is reachable at http://sqlite-api:8108. Statements are executed by a real SQLite engine. /api/v1/query is read-only, /api/v1/execute may write, and /api/v1/transaction runs a batch atomically. The X-API-Key header selects access: sqlite_ro_2b90d7fc1e6a4830 is read-only and refuses writes, sqlite_key_9f3c1a7e5b2d4086 (or any other token, or none) is read/write.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8108"
    }
  ],
  "item": [
    {
      "name": "health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "health db",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health/db"
      }
    },
    {
      "name": "query simple select",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/query",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"sql\": \"SELECT id, sku, name, stock_qty FROM parts ORDER BY sku\"}"
        }
      }
    },
    {
      "name": "query join and aggregate",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/query",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"sql\": \"SELECT s.customer, COUNT(*) AS work_orders, SUM(w.minutes_spent) AS minutes FROM work_orders w JOIN sites s ON s.id = w.site_id GROUP BY s.customer ORDER BY work_orders DESC, s.customer\"}"
        }
      }
    },
    {
      "name": "query with bound parameters",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/query",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"sql\": \"SELECT id, summary, minutes_spent FROM work_orders WHERE status = ? AND priority = ? ORDER BY id\", \"params\": [\"closed\", \"P1\"]}"
        }
      }
    },
    {
      "name": "query with named parameters",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/query",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"sql\": \"SELECT sku, stock_qty, reorder_level FROM parts WHERE stock_qty < :threshold ORDER BY stock_qty\", \"params\": {\"threshold\": 10}}"
        }
      }
    },
    {
      "name": "query a view",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/query",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"sql\": \"SELECT * FROM open_work_orders ORDER BY priority, id\"}"
        }
      }
    },
    {
      "name": "query with a CTE",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/query",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"sql\": \"WITH part_cost AS (SELECT work_order_id, SUM(quantity * unit_cost_cents) AS cents FROM work_order_parts GROUP BY work_order_id) SELECT w.id, w.summary, part_cost.cents FROM work_orders w JOIN part_cost ON part_cost.work_order_id = w.id ORDER BY part_cost.cents DESC LIMIT 3\"}"
        }
      }
    },
    {
      "name": "query with a window function",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/query",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"sql\": \"SELECT id, priority, minutes_spent, RANK() OVER (PARTITION BY priority ORDER BY minutes_spent DESC) AS rank_in_priority FROM work_orders WHERE status = 'closed' ORDER BY priority, rank_in_priority\"}"
        }
      }
    },
    {
      "name": "query left join with null handling",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/query",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"sql\": \"SELECT t.name, COUNT(w.id) AS assigned FROM technicians t LEFT JOIN work_orders w ON w.technician_id = t.id GROUP BY t.id ORDER BY assigned DESC, t.name\"}"
        }
      }
    },
