{
  "info": {
    "name": "Supabase Self-Host Mock API v1",
    "description": "Test collection for the mock self-hosted Supabase service. Base URL defaults to http://localhost:8102. In docker-compose, the service is reachable at http://supabase-api:8102. The apikey header selects the Postgres role: absent or the anon key (eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.anon.orbit-labs-selfhost) = anon and sees public rows only; the service key (eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost) = service_role and bypasses RLS; any other token = authenticated.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8102"}
  ],
  "item": [
    {"name": "health", "request": {"method": "GET", "url": "{{baseUrl}}/health"}},
    {"name": "rest root schema", "request": {"method": "GET", "url": "{{baseUrl}}/rest/v1/"}},
    {"name": "list profiles", "request": {"method": "GET", "url": "{{baseUrl}}/rest/v1/profiles?select=id,username,full_name,role&order=username.asc",
      "header": [{"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.anon.orbit-labs-selfhost"}]}},
    {"name": "list projects as anon (RLS hides private rows)", "request": {"method": "GET", "url": "{{baseUrl}}/rest/v1/projects?select=id,name,visibility"}},
    {"name": "list projects as service_role", "request": {"method": "GET", "url": "{{baseUrl}}/rest/v1/projects?select=id,name,visibility,status&order=id.asc",
      "header": [{"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}]}},
    {"name": "filter projects (gte + eq)", "request": {"method": "GET", "url": "{{baseUrl}}/rest/v1/projects?visibility=eq.public&star_count=gte.20&select=id,name,star_count",
      "header": [{"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}]}},
    {"name": "embed documents into project", "request": {"method": "GET", "url": "{{baseUrl}}/rest/v1/projects?id=eq.101&select=id,name,documents(id,title,status)",
      "header": [{"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}]}},
    {"name": "list published documents", "request": {"method": "GET", "url": "{{baseUrl}}/rest/v1/documents?status=eq.published&select=id,title,word_count&order=word_count.desc&limit=3"}},
    {"name": "document with author and comments", "request": {"method": "GET", "url": "{{baseUrl}}/rest/v1/documents?id=eq.501&select=id,title,profiles(username,full_name),comments(id,body,resolved)",
      "header": [{"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}]}},
    {"name": "search documents by tag (cs)", "request": {"method": "GET", "url": "{{baseUrl}}/rest/v1/documents?tags=cs.{security}&select=id,title,tags",
      "header": [{"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}]}},
    {"name": "list comments (ilike)", "request": {"method": "GET", "url": "{{baseUrl}}/rest/v1/comments?body=ilike.*rollback*&select=id,document_id,body",
      "header": [{"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}]}},
    {"name": "unknown relation (404 expected)", "request": {"method": "GET", "url": "{{baseUrl}}/rest/v1/orders?select=*",
      "header": [{"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}]}},
    {"name": "insert document", "request": {"method": "POST", "url": "{{baseUrl}}/rest/v1/documents",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}, {"key": "Prefer", "value": "return=representation"}],
      "body": {"mode": "raw", "raw": "{\"project_id\": 101, \"author_id\": \"a41f7c88-5be9-42d7-9c03-77e2f8b41d16\", \"title\": \"Token family revocation audit\", \"body\": \"Audit trail for every revoked refresh-token family, retained for 90 days.\", \"status\": \"draft\", \"tags\": [\"auth\", \"audit\"]}"}}},
    {"name": "insert document with bad FK (409 expected)", "request": {"method": "POST", "url": "{{baseUrl}}/rest/v1/documents",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}],
      "body": {"mode": "raw", "raw": "{\"project_id\": 999, \"title\": \"Orphan document\", \"body\": \"No such project.\"}"}}},
    {"name": "insert document as anon (401 expected - RLS)", "request": {"method": "POST", "url": "{{baseUrl}}/rest/v1/documents",
      "header": [{"key": "Content-Type", "value": "application/json"}],
      "body": {"mode": "raw", "raw": "{\"project_id\": 103, \"title\": \"Unauthorized insert\", \"body\": \"Should be rejected by row-level security.\"}"}}},
    {"name": "update document status", "request": {"method": "PATCH", "url": "{{baseUrl}}/rest/v1/documents?id=eq.503",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}],
      "body": {"mode": "raw", "raw": "{\"status\": \"in_review\", \"word_count\": 1010}"}}},
    {"name": "delete comment", "request": {"method": "DELETE", "url": "{{baseUrl}}/rest/v1/comments?id=eq.9007",
      "header": [{"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}]}},
    {"name": "rpc project_stats", "request": {"method": "POST", "url": "{{baseUrl}}/rest/v1/rpc/project_stats",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}],
      "body": {"mode": "raw", "raw": "{\"project_id\": 101}"}}},
    {"name": "rpc search_documents", "request": {"method": "POST", "url": "{{baseUrl}}/rest/v1/rpc/search_documents",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}],
      "body": {"mode": "raw", "raw": "{\"query\": \"rotation\", \"limit\": 5}"}}},
    {"name": "rpc publish_document", "request": {"method": "POST", "url": "{{baseUrl}}/rest/v1/rpc/publish_document",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}],
      "body": {"mode": "raw", "raw": "{\"document_id\": 505}"}}},
    {"name": "rpc unknown function (404 expected)", "request": {"method": "POST", "url": "{{baseUrl}}/rest/v1/rpc/archive_project",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}],
      "body": {"mode": "raw", "raw": "{\"project_id\": 105}"}}},
    {"name": "list buckets as anon (public only)", "request": {"method": "GET", "url": "{{baseUrl}}/storage/v1/bucket"}},
    {"name": "list buckets as service_role", "request": {"method": "GET", "url": "{{baseUrl}}/storage/v1/bucket",
      "header": [{"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}]}},
    {"name": "get bucket", "request": {"method": "GET", "url": "{{baseUrl}}/storage/v1/bucket/avatars"}},
    {"name": "create bucket", "request": {"method": "POST", "url": "{{baseUrl}}/storage/v1/bucket",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}],
      "body": {"mode": "raw", "raw": "{\"id\": \"exports\", \"name\": \"exports\", \"public\": false, \"file_size_limit\": 10485760, \"allowed_mime_types\": [\"text/csv\"]}"}}},
    {"name": "list objects in bucket", "request": {"method": "POST", "url": "{{baseUrl}}/storage/v1/object/list/project-assets",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}],
      "body": {"mode": "raw", "raw": "{\"prefix\": \"auth-service/\", \"limit\": 10, \"offset\": 0}"}}},
    {"name": "get object info", "request": {"method": "GET", "url": "{{baseUrl}}/storage/v1/object/info/avatars/public/amelia.png"}},
    {"name": "create signed url", "request": {"method": "POST", "url": "{{baseUrl}}/storage/v1/object/sign/invoices/2026/05/ORBIT-0042.pdf",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}],
      "body": {"mode": "raw", "raw": "{\"expiresIn\": 900}"}}},
    {"name": "delete object", "request": {"method": "DELETE", "url": "{{baseUrl}}/storage/v1/object/db-backups/daily/2026-05-26.sql.gz",
      "header": [{"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}]}},
    {"name": "delete non-empty bucket (409 expected)", "request": {"method": "DELETE", "url": "{{baseUrl}}/storage/v1/bucket/avatars",
      "header": [{"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}]}},
    {"name": "list edge functions", "request": {"method": "GET", "url": "{{baseUrl}}/functions/v1"}},
    {"name": "invoke edge function", "request": {"method": "POST", "url": "{{baseUrl}}/functions/v1/generate-report",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}],
      "body": {"mode": "raw", "raw": "{\"period\": \"2026-05\"}"}}},
    {"name": "invoke throttled function (429 expected)", "request": {"method": "POST", "url": "{{baseUrl}}/functions/v1/resize-avatar",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}],
      "body": {"mode": "raw", "raw": "{\"object\": \"public/amelia.png\"}"}}},
    {"name": "list realtime channels", "request": {"method": "GET", "url": "{{baseUrl}}/realtime/v1/channels"}},
    {"name": "broadcast realtime message", "request": {"method": "POST", "url": "{{baseUrl}}/realtime/v1/api/broadcast",
      "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role.orbit-labs-selfhost"}],
      "body": {"mode": "raw", "raw": "{\"messages\": [{\"topic\": \"public:documents\", \"event\": \"document_published\", \"payload\": {\"id\": 505}}]}"}}},
    {"name": "list projects (management)", "request": {"method": "GET", "url": "{{baseUrl}}/v1/projects"}},
    {"name": "get project settings", "request": {"method": "GET", "url": "{{baseUrl}}/v1/projects/orbitlabsselfhost01"}}
  ]
}
