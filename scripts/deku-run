#!/usr/bin/env bash
# One command: build a trajectory, grade it, publish it.
#
#   bin/deku-run tasks/calculator
#   bin/deku-run tasks/streak-habit-tracker -m anthropic/claude-sonnet-4-5-20250929
#   bin/deku-run tasks/calculator --shared-only     # skip the clean-container regrade
#   bin/deku-run tasks/calculator -a nop            # free pipeline smoke test
#
# POLICY: evaluation ALWAYS runs in a fresh container, never in the agent's.
#
#   1. harbor run --disable-verification    agent builds the app; Harbor does NOT grade
#   2. eval_fresh.py                        redeploy into a CLEAN container and grade there
#   3. repackage.py --verifier-dir          publish  -> output/... graded_by=verifier_fresh
#
# Grading in the agent's own container measures the process the agent LEFT
# RUNNING, not the app it BUILT: warm caches, hand-started servers, background
# processes, and state created by hand all prop it up. Redeploying from cold
# removes every one of those.
#
# Disabling Harbor's verifier is not just tidiness. It means tests/ -- the answer
# key -- is never uploaded into the agent's container at all, closing the spatial
# isolation gap TEAM_GUIDE 5.2 flags as a known weakening of shared mode. It also
# halves the grader LLM spend, since the app is graded once rather than twice.
#
# --in-place is the escape hatch for a task whose spec does not yet require
# /app/start.sh; without that file there is nothing to redeploy.
#
# Any extra flags are passed straight through to `harbor run`.

set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

# Load .env (gitignored; see .env.example) so DEKU_* config does not have to be
# exported by hand in every terminal.
#
# `set -a` is what makes this useful: a bare `VAR=value` line assigns a
# SHELL-LOCAL variable, which python's os.environ never sees. Without it,
# `echo $DEKU_PROJECT_ID` prints the right value while post_usage.py still
# reports "DEKU_PROJECT_ID is unset" -- a genuinely confusing failure.
#
# A variable already present in the real environment WINS: this only fills in
# what is unset, so `DEKU_BUDGET_TYPE=Production bin/deku-run ...` still
# overrides the file for a one-off run.
if [[ ! -f "$REPO/.env" ]]; then
  echo "==> .env is missing -- refusing to run." >&2
  echo >&2
  echo "    A run without it completes and then silently reports nothing to" >&2
  echo "    finance: no DEKU_PROJECT_ID means no dashboard row, and you only" >&2
  echo "    find out after the agent time is already spent. Failing here" >&2
  echo "    costs seconds; failing at the end costs a whole run." >&2
  echo >&2
  echo "    Fix:  cp .env.example .env   then fill in DEKU_PROJECT_ID" >&2
  exit 2
fi

if [[ -f "$REPO/.env" ]]; then
  while IFS= read -r _line || [[ -n "$_line" ]]; do
    case "$_line" in
      ''|'#'*) continue ;;
      *=*) : ;;
      *) continue ;;
    esac
    _key="${_line%%=*}"
    _key="${_key#"${_key%%[![:space:]]*}"}"          # ltrim
    _key="${_key%"${_key##*[![:space:]]}"}"          # rtrim
    [[ "$_key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    # already set in the real environment -> leave it alone
    [[ -n "${!_key:-}" ]] && continue
    set -a; eval "$_line"; set +a
  done < "$REPO/.env"
  unset _line _key
fi

TASK="${1:-}"
if [[ -z "$TASK" || "$TASK" == -* ]]; then
  echo "usage: bin/deku-run <task-path> [--shared-only] [harbor flags...]" >&2
  echo "   e.g. bin/deku-run tasks/calculator" >&2
  exit 2
fi
shift

# Refresh this task's copy of the shared grader before running it.
#
# harness/eval/{run_rubric,run_workflows,grader_compress}.py are the source of
# truth, but they never execute: each task carries its own copy under tests/,
# which is what gets mounted at /tests in the container. Edit the master, forget
# to sync, and the run silently grades with the OLD code -- the edit appears to
# do nothing and there is no error to notice.
#
# Syncing here makes that unmissable class of mistake impossible, and costs a
# file compare. Only the task being run is touched; use
# `harness/sync_verifier.py tasks/*/` to update the whole corpus before a commit.
# `|| true`: a sync problem must not block a run that would otherwise work.
if [[ -d "$TASK" ]]; then
  python3 harness/sync_verifier.py "$TASK" >/dev/null 2>&1 || true
fi

# ---------------------------------------------------------------------------
# Anthropic base-URL aliasing: the two names must always agree.
# ---------------------------------------------------------------------------
# Two different consumers read two different variables for the SAME value:
#   ANTHROPIC_BASE_URL  -- Harbor's claude-code agent, and the graders
#                          (harness/eval/run_workflows.py)
#   ANTHROPIC_API_BASE  -- openhands, which routes through litellm
#
# Set only one and the other consumer silently ignores the bridge and dials
# api.anthropic.com directly, sending the bridge secret as a real API key. That
# surfaces a full agent-run later as `401 invalid x-api-key` inside a litellm
# traceback, which names neither the variable nor the bridge. Measured cost of
# learning this the hard way: one paid agent run (2026-08-11).
#
# README.md's "claude-code reads ANTHROPIC_BASE_URL, not the ANTHROPIC_API_BASE
# the bridge prints" is correct for claude-code and actively misleading for the
# DEFAULT agent, which is openhands. Rather than ask anyone to remember which
# agent wants which spelling, mirror whichever one is set onto the other.
#
# Neither set is left alone on purpose: that is the legitimate "talk straight to
# api.anthropic.com with a real key" path, and forcing a bridge URL would break it.
if [[ -n "${ANTHROPIC_BASE_URL:-}" && -z "${ANTHROPIC_API_BASE:-}" ]]; then
  export ANTHROPIC_API_BASE="$ANTHROPIC_BASE_URL"
elif [[ -n "${ANTHROPIC_API_BASE:-}" && -z "${ANTHROPIC_BASE_URL:-}" ]]; then
  export ANTHROPIC_BASE_URL="$ANTHROPIC_API_BASE"
elif [[ -n "${ANTHROPIC_BASE_URL:-}" && "${ANTHROPIC_BASE_URL}" != "${ANTHROPIC_API_BASE}" ]]; then
  echo "==> WARNING: ANTHROPIC_BASE_URL and ANTHROPIC_API_BASE disagree:" >&2
  echo "      ANTHROPIC_BASE_URL = $ANTHROPIC_BASE_URL" >&2
  echo "      ANTHROPIC_API_BASE = $ANTHROPIC_API_BASE" >&2
  echo "    The agent and the grader will talk to different endpoints." >&2
fi

AGENT="openhands"
# claude-opus-4-8, not 4-5: pricing.py has no rate for claude-opus-4-5, so a
# default run reported a null trajectory cost and finance refused the record.
# Every run to date has passed `-m anthropic/claude-opus-4-8` by hand to avoid
# exactly that; this makes the default match what people actually use.
MODEL="anthropic/claude-opus-4-8"
FRESH=1
# Bash 3.2 (the macOS default) errors on "${arr[@]}" for an EMPTY array under
# `set -u`. The ${arr[@]+"${arr[@]}"} form expands to nothing when unset and to
# the elements otherwise, and is safe on both 3.2 and 5.x.
PASSTHRU=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --in-place|--shared-only) FRESH=0; shift ;;
    -a|--agent)    AGENT="$2"; shift 2 ;;
    -m|--model)    MODEL="$2"; shift 2 ;;
    *)             PASSTHRU+=("$1"); shift ;;
  esac
done

# `nop` and `oracle` take no model, and passing one makes Harbor reject the run.
MODEL_FLAG=(-m "$MODEL")
AK_FLAG=(--ak version=0.62.0)
if [[ "$AGENT" == "nop" || "$AGENT" == "oracle" ]]; then
  MODEL_FLAG=(); AK_FLAG=()
elif [[ "$AGENT" != "openhands" ]]; then
  AK_FLAG=()   # --ak version is an OpenHands kwarg only
fi

# Fail early rather than 15 minutes in with an unreachable grader.
if [[ -z "${ANTHROPIC_API_KEY:-}" ]]; then
  echo "ANTHROPIC_API_KEY is not set -- Harbor will refuse to start." >&2
  echo "Set the bridge env first (see the runbook), then re-run." >&2
  exit 2
fi

# Prove this machine can run BOTH phases before spending anything.
#
# harness/preflight.sh checks the host tooling, the grader sources, the LLM
# endpoint from the host AND from a container, and the task's own shape. Every
# check in it corresponds to a failure that has already cost a run and pointed
# somewhere other than its cause.
#
# The container check is the one that matters most: the host reaching the bridge
# says nothing about a container reaching it, and openhands resolves LLM_BASE_URL
# rather than the ANTHROPIC_* names.
#
# DEKU_SKIP_PREFLIGHT=1 bypasses it.
if [[ -z "${DEKU_SKIP_PREFLIGHT:-}" ]]; then
  bash harness/preflight.sh "$TASK" "$AGENT" || exit 2
fi

# Snapshot the existing jobs BEFORE running, so the trial we grade afterwards is
# provably the one this invocation produced. Taking "newest" alone is wrong: when
# the agent phase fails to start a trial at all, newest-first silently returns a
# PREVIOUS run -- and we would then regrade and republish an unrelated task's
# result as though it were this one.
BEFORE="$(ls -d jobs/*/ 2>/dev/null | sort)"

# Artifacts are collected BEFORE the verifier runs (harbor/trial/single_step.py:45
# vs :52), so --disable-verification still yields the /app artifact that phase 2
# redeploys. Verified, not assumed.
VERIFY_FLAG=(--disable-verification)
if [[ "$FRESH" == "0" ]]; then
  VERIFY_FLAG=()
  echo "==> --in-place: grading in the AGENT's container (warm caches, hand-started"
  echo "    server, agent-created state). Use only for tasks whose spec does not"
  echo "    yet require /app/start.sh."
fi

# The deployment contract lives HERE, not in any instruction.md.
#
# How the app is collected, redeployed and graded is a property of the harness
# and is identical for every task, so it belongs in one file rather than copied
# into eleven briefs -- where it also drifted, and where each portability trap
# found had to be re-worded by hand. Harbor renders it around the task's own
# instruction via `prompt_template_path`, so the brief stays a description of the
# product and nothing else.
#
# Set DEKU_PROMPT_TEMPLATE= (empty) to run a task with its brief unwrapped.
PROMPT_TEMPLATE="${DEKU_PROMPT_TEMPLATE-$REPO/harness/prompt/deployment_contract.j2}"
TEMPLATE_FLAG=()
if [[ -n "$PROMPT_TEMPLATE" ]]; then
  if [[ -f "$PROMPT_TEMPLATE" ]]; then
    TEMPLATE_FLAG=(--ak "prompt_template_path=$PROMPT_TEMPLATE")
    echo "==> deployment contract: $(basename "$PROMPT_TEMPLATE") (wrapped around the brief)"
  else
    echo "==> WARNING: prompt template not found at $PROMPT_TEMPLATE; running unwrapped" >&2
  fi
fi

# No grader sync here on purpose.
#
# It would be redundant: eval_fresh.py assembles /tests itself and overlays the
# shared grader AND the task's instruction.md straight from harness/ and the task
# directory, after copying tests/. Whatever those on-disk copies contain, the
# container runs the current files.
#
# The copies under tasks/*/tests/ exist because Harbor uploads only tests/ when
# HARBOR grades. deku-run passes --disable-verification, so that path is unused
# here. Run harness/sync_verifier.py by hand to keep the copies tidy for reading,
# or before using Harbor's own verifier.

echo "==> [1/3] agent phase: $AGENT on $(basename "$TASK")"
yes | bin/harbor run --path "$REPO/${TASK#./}" -a "$AGENT" \
      ${MODEL_FLAG[@]+"${MODEL_FLAG[@]}"} ${AK_FLAG[@]+"${AK_FLAG[@]}"} \
      ${TEMPLATE_FLAG[@]+"${TEMPLATE_FLAG[@]}"} \
      ${VERIFY_FLAG[@]+"${VERIFY_FLAG[@]}"} \
      --n-concurrent-agents 1 ${PASSTHRU[@]+"${PASSTHRU[@]}"}
HARBOR_RC=$?

AFTER="$(ls -d jobs/*/ 2>/dev/null | sort)"
JOB="$(comm -13 <(printf '%s\n' "$BEFORE") <(printf '%s\n' "$AFTER") | tail -1)"
if [[ -z "$JOB" ]]; then
  echo >&2
  echo "This run produced no new job directory, so there is nothing to grade." >&2
  echo "The agent phase did not start -- check the harbor output above." >&2
  exit "${HARBOR_RC:-1}"
fi

TRIAL="$(ls -td "$JOB"*__*/ 2>/dev/null | head -1)"
TRIAL="${TRIAL%/}"
if [[ -z "$TRIAL" || ! -d "$TRIAL" ]]; then
  echo "job $JOB has no trial directory -- the agent phase did not run." >&2
  exit "${HARBOR_RC:-1}"
fi

# A trial DIRECTORY is not a trial that RAN. Harbor creates the directory during
# Trial.create(), before the environment is built, so a task rejected at
# validation leaves a directory containing nothing.
#
# 2026-08-11: tasks/bundle declared network_mode="allowlist", which Docker
# Desktop's kernel cannot enforce. Harbor raised before the agent started, and
# this script marched on to eval_fresh -- which crashed with a raw
# FileNotFoundError on config.json -- and then printed a SCORE table reading
# "(not produced)" twice, under a heading that implies a run happened. The real
# error was thirty lines of traceback further up.
if [[ ! -f "$TRIAL/config.json" ]]; then
  echo >&2
  echo "==> AGENT PHASE DID NOT RUN" >&2
  echo "    $TRIAL exists but has no config.json, so Harbor aborted before the" >&2
  echo "    trial started. The cause is in the harbor output above -- scroll to the" >&2
  echo "    LAST line of the traceback, which names it." >&2
  echo >&2
  echo "    Most common: network_mode is 'allowlist' but Docker Desktop's LinuxKit" >&2
  echo "    kernel cannot enforce it. Set network_mode = \"public\" in task.toml." >&2
  exit "${HARBOR_RC:-1}"
fi
echo "==> trial: $TRIAL"

if [[ "$FRESH" == "0" ]]; then
  echo "==> [2/3] publishing the in-place grading"
  python3 harness/repackage.py "$TRIAL" || true
  echo "==> [3/3] done (--in-place: no clean-container grade)"
  exit "${HARBOR_RC:-0}"
fi

echo "==> [2/3] grading in a clean container"
bin/deku-py harness/eval_fresh.py "$TRIAL"
FRESH_RC=$?

echo "==> [3/3] publishing"
if [[ -d "$TRIAL/verifier_fresh" ]]; then
  python3 harness/repackage.py "$TRIAL" --verifier-dir verifier_fresh || true
fi

echo
echo "=================== SCORE ===================="
for pair in "verifier_fresh:clean container" "verifier:in-place (shared container)"; do
  d="${pair%%:*}"; label="${pair#*:}"
  f="$TRIAL/$d/reward.json"
  if [[ -f "$f" ]]; then
    printf '  %-28s %s\n' "$label" "$(python3 -c "import json,sys;print(json.load(open(sys.argv[1]))['reward'])" "$f")"
  else
    printf '  %-28s (not produced)\n' "$label"
  fi
done
echo "=============================================="
echo "output/ now holds both, tagged manifest.graded_by"

# ---------------------------------------------------------------------------
# Optional: report this run to the finance API.
# ---------------------------------------------------------------------------
# OFF unless DEKU_FINANCE_AUTOPOST=true. Posting is an outward-facing, billed
# action, so it stays opt-in rather than something a routine `deku-run` does by
# surprise. Set it in .env alongside the other DEKU_FINANCE_* config.
#
# `|| true` is load-bearing, and so is running this AFTER the score table: a
# finance outage, a bad token, or a stale trajectory must never turn a
# successful trial into a failed command or hide the score. post_usage.py is
# already idempotent -- it keys receipts by trajectory_id across every run
# directory -- so a re-run of this script cannot double-bill.
# `${VAR,,}` is a bash 4 lowercase expansion and macOS ships bash 3.2, where it
# is a hard "bad substitution" parse error that would break this whole script.
# `tr` is the portable equivalent.
if [[ "$(printf '%s' "${DEKU_FINANCE_AUTOPOST:-}" | tr 'A-Z' 'a-z')" == "true" ]]; then
  echo
  echo "==> [4/4] reporting usage to finance (DEKU_FINANCE_AUTOPOST=true)"
  # post_usage.py takes the PUBLISHED run directory (output/<task>/<model>/run_N),
  # not the jobs/ trial directory -- it reads manifest.json, which only exists
  # after repackage. Match on manifest.source_job so we bill the run we just
  # published rather than whichever directory happens to be newest.
  RUN_DIR="$(python3 - "$TRIAL" <<'PY'
import glob, json, sys
trial = sys.argv[1].rstrip("/")
for m in glob.glob("output/*/*/run_*/manifest.json"):
    try:
        if json.load(open(m)).get("source_job", "").rstrip("/") == trial:
            print(m.rsplit("/", 1)[0]); break
    except Exception:
        pass
PY
)"
  if [[ -z "$RUN_DIR" ]]; then
    echo "    no published run directory matches $TRIAL -- nothing to report." >&2
  else
    python3 harness/finance/post_usage.py "$RUN_DIR" --post || \
      echo "    finance post failed -- the run itself is unaffected; re-run" \
           "harness/finance/post_usage.py '$RUN_DIR' --post later to bill it." >&2
  fi
fi

exit "${FRESH_RC:-0}"
